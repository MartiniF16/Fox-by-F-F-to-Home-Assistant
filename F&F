sensor:
  - platform: rest
    name: fox_current_parameters
    resource: "http://192.168.1.170/0000/get_current_parameters"
    scan_interval: 5
    value_template: "{{ value_json.status | default('ok') }}"
    json_attributes:
      - voltage
      - current
      - power_active
      - power_reactive
      - frequency
      - power_factor

  - platform: rest
    name: fox_total_energy
    resource: "http://192.168.1.170/0000/get_total_energy"
    scan_interval: 30
    value_template: "{{ value_json.status | default('ok') }}"
    json_attributes:
      - active_energy_import
      - active_energy_export
      - reactive_energy_import
      - reactive_energy_export
      
  - platform: filter
    name: "FOX Energy Import Filtered"
    entity_id: sensor.fox_energy_import_total
    filters:
      - filter: outlier
        window_size: 4
        radius: 20
      - filter: lowpass
        time_constant: 10
